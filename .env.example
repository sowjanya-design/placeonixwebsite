# SMTP settings for the application-form email (server.js / api/applications.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Used by api/applications.js (Vercel) as the notification recipient list.
# server.js hardcodes enquiry@placeonix.com, support@placeonix.com instead.
ADMIN_EMAILS=enquiry@placeonix.com,support@placeonix.com

# Optional — defaults to 3000
PORT=3000
